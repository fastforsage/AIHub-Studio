{
  "id": "qwen",
  "name": "Qwen",
  "vendor": "Alibaba",
  "version": 1,
  "enabled": true,
  "domains": [
    "qwen.ai"
  ],
  "detection": {
    "minimum_confidence": 0.75,
    "dom_signatures": [
      "[data-testid*='message']",
      "[class*='chat-message']"
    ]
  },
  "capabilities": {
    "text": true,
    "attachments": true,
    "images": true,
    "audio": false,
    "streaming": true,
    "conversation_history": true
  },
  "extraction": {
    "strategies": [
      "semantic_dom"
    ],
    "message_selectors": [],
    "role_mapping": {
      "user": "user",
      "assistant": "assistant"
    }
  }
}
